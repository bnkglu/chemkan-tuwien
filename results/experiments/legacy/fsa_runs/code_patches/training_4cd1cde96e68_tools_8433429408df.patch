    rows = []
    for lv in levels:
        batch = P.stage1(model, idx=P.H2_SUBSET)
        fdb = FunctionalDynamics(batch.dynamics, batch.params)
        xb, Sb = integrate_with_sensitivities(fdb, batch.x0, batch.t, V.cfg(LADDER[lv]))
