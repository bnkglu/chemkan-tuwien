# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
.pytest_cache/
.ruff_cache/
.claude/settings.local.json

# Virtual environments
.venv/
venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Data & model artifacts (large files)
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.pkl

# Generated datasets and model files are ignored by default ...
*.npz
*.log

# ... except the datasets the training, evaluation and figure scripts read (regenerate any
# of them with chemkan/scripts/data_gen/, see its README)
!chemkan/data/generated/biodiesel_v2.npz
!chemkan/data/generated/biodiesel_v2_paper_order.npz
!chemkan/data/generated/hydrogen.npz
!chemkan/data/generated/hydrogen_fine.npz
!chemkan/data/generated/hydrogen_temperature_20000.npz
!chemkan/data/generated/methane.npz
!chemkan/data/generated/methane_fine.npz
!chemkan/data/generated/methane_temperature_20000.npz

# results/ holds the records of the reported experiments: tracked, except resume checkpoints
!results/**/*.pt
!results/**/*.npz
!results/**/*.log
results/**/*_working.pt
results/**/checkpoint_resume.pt
# committed with the methane Stage-1 record
!results/methane/S1_seed0/stage1_working.pt

# Inputs rebuilt from the released example (chemkan/scripts/biodiesel/build_*.py)
results/biodiesel/released_example/data/

# New training runs (launchers and examples write here)
runs/
train_example/
wandb/
lightning_logs/

# Environment variables
.env
.env.local
